# Ninguna variable es obligatoria: todas tienen un default razonable y la API
# de WordPress es pública y de solo lectura. Copia este archivo a .env solo si
# necesitas cambiar alguno.

# Puerto del servidor Express.
# En esta máquina el 5000 suele estar ocupado por otro proyecto: usa 5001.
PORT=5000

# Origen del contenido editorial (WordPress headless).
WP_API_BASE=https://comunidad.asociacionesprofesionales.org/wp-json/wp/v2
