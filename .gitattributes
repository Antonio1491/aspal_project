# Normaliza a LF en el repositorio. Sin esto, cada commit desde Windows avisa
# de la conversión CRLF y el diff depende del sistema operativo de quien edita.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
